# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 飞书自建应用凭据（开发者后台 -> 应用 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标多维表格定位（从 Bitable URL 读取，详见 docs/SETUP_FEISHU.md）
# URL 形如 https://xxx.feishu.cn/base/<APP_TOKEN>?table=<TABLE_ID>&view=...
FEISHU_APP_TOKEN=bascxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxxxx

# 海外 Lark 租户改成 https://open.larksuite.com；国内飞书保持默认即可
# FEISHU_BASE_URL=https://open.feishu.cn
